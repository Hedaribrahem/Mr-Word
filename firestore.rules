rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ضع هنا UID حساب المشرف (من Authentication ← Users)
    function isAdmin() {
      return request.auth != null && request.auth.uid == '6SiMSd1xJNXqYwIZF2O77R2FbO32';
    }

    // التقييمات + عدّادات التحميل والمشاهدة: قراءة للجميع، وزيادة محدودة فقط
    match /ratings/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['sum', 'count', 'n'])
        && request.resource.data.get('n', 0) <= 1
        && request.resource.data.get('count', 0) <= 1
        && request.resource.data.get('sum', 0) >= 0
        && request.resource.data.get('sum', 0) <= 5;
      allow update: if request.resource.data.keys().hasOnly(['sum', 'count', 'n'])
        && request.resource.data.get('n', 0) - resource.data.get('n', 0) >= 0
        && request.resource.data.get('n', 0) - resource.data.get('n', 0) <= 1
        && request.resource.data.get('count', 0) - resource.data.get('count', 0) >= 0
        && request.resource.data.get('count', 0) - resource.data.get('count', 0) <= 1
        && request.resource.data.get('sum', 0) - resource.data.get('sum', 0) >= -4
        && request.resource.data.get('sum', 0) - resource.data.get('sum', 0) <= 5;
      allow delete: if isAdmin();
    }

    // التعليقات وآراء الزوار: لا تظهر للعامة إلا بعد الموافقة
    match /comments/{id} {
      allow read: if resource.data.s == 'approved' || isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['k', 'n', 't', 's', 'c', 'g'])
        && request.resource.data.s == 'pending'
        && request.resource.data.c == request.time
        && request.resource.data.k is string && request.resource.data.k.size() < 100
        && request.resource.data.n is string && request.resource.data.n.size() >= 1 && request.resource.data.n.size() <= 40
        && request.resource.data.t is string && request.resource.data.t.size() >= 1 && request.resource.data.t.size() <= 600
        && (!('g' in request.resource.data) || (request.resource.data.g is int && request.resource.data.g >= 1 && request.resource.data.g <= 5));
      allow update, delete: if isAdmin();
    }

    // طلبات الخدمة: للمشرف فقط قراءة وتعديل
    match /requests/{id} {
      allow create: if request.resource.data.keys().hasOnly(['n', 'c', 'v', 'd', 's', 'dl', 't'])
        && request.resource.data.s == 'new'
        && request.resource.data.t == request.time
        && request.resource.data.n is string && request.resource.data.n.size() >= 1 && request.resource.data.n.size() <= 60
        && request.resource.data.c is string && request.resource.data.c.size() <= 80
        && request.resource.data.v is string && request.resource.data.v.size() <= 10
        && request.resource.data.d is string && request.resource.data.d.size() >= 10 && request.resource.data.d.size() <= 1500
        && (!('dl' in request.resource.data) || request.resource.data.dl.size() <= 60);
      allow read, update, delete: if isAdmin();
    }

    // المشتركون في القائمة البريدية: للمشرف فقط
    match /subscribers/{id} {
      allow create: if request.resource.data.keys().hasOnly(['e', 'l', 'c', 'n', 't'])
        && request.resource.data.c == true
        && request.resource.data.t == request.time
        && request.resource.data.e is string && request.resource.data.e.size() <= 80
        && request.resource.data.e.matches('^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$')
        && request.resource.data.l in ['ar', 'en']
        && (!('n' in request.resource.data) || request.resource.data.n.size() <= 60);
      allow read, update, delete: if isAdmin();
    }
  }
}
